# Copy thành .env rồi điền token thật (file .env đã được .gitignore)
HF_TOKEN=hf_xxx

# Sau khi đã tải model 1 lần (folder ./hf-cache có dữ liệu), đặt =1
# để vLLM đọc thẳng từ cache, bỏ bước gọi mạng -> khởi động nhanh hơn.
HF_HUB_OFFLINE=0

# (tuỳ chọn) đổi nơi lưu cache model trên host
# HF_CACHE_DIR=./hf-cache
